# Same values as the web app's .env.local, prefixed EXPO_PUBLIC_ instead of
# NEXT_PUBLIC_ (Expo's convention for vars inlined into the client bundle).
# Only ever put public/anon/publishable keys here - never a secret/service
# key, mobile or web, and never a "default" AI/search provider key either
# (see the warning below - those get proxied server-side now, not bundled).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=

# The deployed web app's origin - lib/webApi.ts calls its API routes
# (/api/friends/*, /api/ai/*, /api/external/*) since those need real
# secrets server-side and this app has no server of its own.
EXPO_PUBLIC_WEB_API_URL=

# Do NOT add EXPO_PUBLIC_TMDB_API_KEY / EXPO_PUBLIC_RAWG_API_KEY /
# EXPO_PUBLIC_GEMINI_API_KEY here - a bundled default key ships inside
# this app's JS, extractable by anyone who unpacks the installed app
# (the same bug the web app had and fixed). TMDB/RAWG/Gemini fall back to
# the deployed web app's server-only default-key proxies automatically
# when a user hasn't added their own key in Settings.
