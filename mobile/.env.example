# Same values as the web app's .env.local, prefixed EXPO_PUBLIC_ instead of
# NEXT_PUBLIC_ (Expo's convention for vars inlined into the client bundle).
# Only ever put public/anon/publishable keys here - never a secret/service
# key, mobile or web.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_TMDB_API_KEY=
EXPO_PUBLIC_RAWG_API_KEY=
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=

# The deployed web app's origin - the friends feature calls its
# /api/friends/* routes (see lib/api/friends.ts) since those need the
# Clerk secret key server-side and this app has no server of its own.
EXPO_PUBLIC_WEB_API_URL=

# Optional bundled default for AI features (Gemini fallback client) - no
# default Groq key on either platform, users add their own in Settings.
EXPO_PUBLIC_GEMINI_API_KEY=
